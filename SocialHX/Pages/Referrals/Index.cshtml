@page
@model SocialHX.Pages.Referrals.IndexModel

@{
    ViewData["Title"] = "Referrals";
}

<h1>Referrals</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].Student)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].Submitter)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].SubmitterFirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].SubmitterLastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].SubmitterEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].StudentAware)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Referral[0].Concerns)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Referral)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Student.Email)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Submitter)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SubmitterFirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SubmitterLastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SubmitterEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StudentAware)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Concerns)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ReferralID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ReferralID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ReferralID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
