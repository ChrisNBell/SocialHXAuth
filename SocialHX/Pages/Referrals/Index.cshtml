@page
@model SocialHX.Pages.Referrals.IndexModel

@{
    ViewData["Title"] = "Referrals";
}

<h1>Referrals</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<form method="get" class="btn-group mb-3" role="group" aria-label="Filter referrals by appointment">
    <button type="submit" name="appointmentFilter" value="without"
            class="btn @(Model.AppointmentFilter == "without" ? "btn-primary" : "btn-outline-primary")"
            aria-pressed="@(Model.AppointmentFilter == "without")">Without appointments</button>
    <button type="submit" name="appointmentFilter" value="with"
            class="btn @(Model.AppointmentFilter == "with" ? "btn-primary" : "btn-outline-primary")"
            aria-pressed="@(Model.AppointmentFilter == "with")">With appointments</button>
    <button type="submit" name="appointmentFilter" value="all"
            class="btn @(Model.AppointmentFilter == "all" ? "btn-primary" : "btn-outline-primary")"
            aria-pressed="@(Model.AppointmentFilter == "all")">All</button>
</form>
@if (Model.Referral.Count == 0)
{
    <p>@(Model.AppointmentFilter switch
    {
        "all" => "No referrals found.",
        "with" => "No referrals with appointments found.",
        _ => "No referrals without appointments found."
    })</p>
}
else
{
<table class="table">
    <thead>
        <tr>
            <th>Student</th>
            <th>Submitter</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Email</th>
            <th>Student aware</th>
            <th>Description</th>
            <th>Concerns</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Referral)
        {
            <tr>
                <td>
                    @item.Student?.Email
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Submitter)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SubmitterFirstName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SubmitterLastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SubmitterEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.StudentAware)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Concerns)
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ReferralID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ReferralID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ReferralID">Delete</a> |
                    <a asp-page="/Appointments/Create" asp-route-id="@item.StudentID">Create Appointment</a>
                </td>
            </tr>
        }
    </tbody>
</table>
}
