@page
@model SocialHX.Pages.FollowUpsWeek4.CreateModel

@{
    ViewData["Title"] = "Create";
}
        
<h1>Create</h1>
        
<h4>FollowUpWeek4</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="FollowUpWeek4.PrescriptionID" class="control-label"></label>
                <select asp-for="FollowUpWeek4.PrescriptionID" class="form-control" asp-items="ViewBag.PrescriptionID"
                        aria-required="true"></select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="FollowUpWeek4.DidMeet" /> @Html.DisplayNameFor(model =>
                                        model.FollowUpWeek4.DidMeet)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="FollowUpWeek4.DateTime" class="control-label"></label>
                <input asp-for="FollowUpWeek4.DateTime" class="form-control" />
                <span asp-validation-for="FollowUpWeek4.DateTime" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="FollowUpWeek4.DidAttend" /> @Html.DisplayNameFor(model =>
                                        model.FollowUpWeek4.DidAttend)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="FollowUpWeek4.EventsAttended" class="control-label"></label>
                <input asp-for="FollowUpWeek4.EventsAttended" class="form-control" />
                <span asp-validation-for="FollowUpWeek4.EventsAttended" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="FollowUpWeek4.Feelings" class="control-label"></label>
                <input asp-for="FollowUpWeek4.Feelings" class="form-control" aria-required="true" />
                <span asp-validation-for="FollowUpWeek4.Feelings" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="FollowUpWeek4.Barriers" class="control-label"></label>
                <input asp-for="FollowUpWeek4.Barriers" class="form-control" aria-required="true" />
                <span asp-validation-for="FollowUpWeek4.Barriers" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="FollowUpWeek4.Refill" /> @Html.DisplayNameFor(model =>
                                        model.FollowUpWeek4.Refill)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
