@page
@model SocialHX.Pages.Prescribers.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Prescriber</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Prescriber.PrescriberID" />
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Prescriber.Name" class="control-label"></label>
                <input asp-for="Prescriber.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Prescriber.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Prescriber.Email" class="control-label"></label>
                <input asp-for="Prescriber.Email" class="form-control" aria-required="true"/>
                <span asp-validation-for="Prescriber.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Prescriber.Department" class="control-label"></label>
                <input asp-for="Prescriber.Department" class="form-control" aria-required="true"/>
                <span asp-validation-for="Prescriber.Department" class="text-danger"></span>
            </div>
            <div class="form-group">
<span class="text-danger">*</span>
                <label asp-for="Prescriber.Location" class="control-label"></label>
                <input asp-for="Prescriber.Location" class="form-control" aria-required="true"/>
                <span asp-validation-for="Prescriber.Location" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
