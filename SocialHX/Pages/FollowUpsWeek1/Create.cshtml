@page
@model SocialHX.Pages.FollowUpsWeek1.CreateModel

@{
    ViewData["Title"] = "Follow Ups Week 1: Create";
}
        
<h1>Follow Ups Week 1: Create</h1>
        
<h4>FollowUpWeek1</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <!-- <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="FollowUpWeek1.PrescriptionID" class="control-label"></label>
                <select asp-for="FollowUpWeek1.PrescriptionID" class="form-control" asp-items="ViewBag.PrescriptionID"
                        aria-required="true"></select>
            </div> 
            -->



            <input type="hidden" name="PrescriptionID" value="@ViewBag.PID">
@if (Model.Prescription != null)
{
    var student = Model.Prescription.Appointment?.Student;
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title mb-1">Prescription #@Model.Prescription.PrescriptionID</h5>
            @if (student != null)
            {
                <p class="card-text mb-0">@student.FirstName @student.LastName</p>
                <p class="card-text text-muted mb-0">@student.Email</p>
            }
        </div>
    </div>
}
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="FollowUpWeek1.Response" /> @Html.DisplayNameFor(model =>
                                                                                                                                                                                    model.FollowUpWeek1.Response)
                </label>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="FollowUpWeek1.StudentReport" class="control-label"></label>
                <input asp-for="FollowUpWeek1.StudentReport" class="form-control" aria-required="true" />
                <span asp-validation-for="FollowUpWeek1.StudentReport" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="FollowUpWeek1.StudentAdjustments" class="control-label"></label>
                <input asp-for="FollowUpWeek1.StudentAdjustments" class="form-control" aria-required="true" />
                <span asp-validation-for="FollowUpWeek1.StudentAdjustments" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="/Prescriptions/Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
